# Server-only secrets. Set on Vercel (Production and Preview).
# Copy connection URL from Neon Console -> Connect -> pooled connection.
HAMID_ASTRONOMY_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require\n# Optional fallback for local tooling: DATABASE_URL=

# Admin login (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-random-password-at-least-12-characters
ADMIN_SESSION_SECRET=replace-with-at-least-48-cryptographically-random-characters
ALLOW_WEAK_ADMIN_PASSWORD=false

# Do NOT prefix secrets with NEXT_PUBLIC_
